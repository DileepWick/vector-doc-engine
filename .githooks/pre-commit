#!/bin/sh
# Git Pre-Commit Hook: Runs unit tests, TypeScript type checking, and build verification.

echo "Running pre-commit checks..."

# 1. Run Unit Tests
echo "Step 1/3: Running unit tests..."
npm test
if [ $? -ne 0 ]; then
  echo "Error: Unit tests failed. Commit aborted."
  exit 1
fi

# 2. TypeScript Static Type Check
echo "Step 2/3: Checking TypeScript types..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "Error: TypeScript type check failed. Commit aborted."
  exit 1
fi

# 3. Package Compilation Check
echo "Step 3/3: Verifying package build..."
npm run build
if [ $? -ne 0 ]; then
  echo "Error: Package build failed. Commit aborted."
  exit 1
fi

echo "All pre-commit checks passed successfully!"
exit 0
